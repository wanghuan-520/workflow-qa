  "case_format": {
    "runtime_operations": "operations must be exact RuntimeOperation values from SPEC; component and secret broker sub-operations are corpus control inputs, not wire RuntimeOperation enum extensions.",
    "stateful_rules": "evaluate a signed RuntimeHealth snapshot and exact matrix rule before reservation, activation, execution, artifact read, redaction, or update side effects."
  },
  "invalid_cases": [
    {
      "id": "unknown-runtime-operation",
      "mutation": {
        "op": "add",
        "path": "/operations/-",
        "value": "materialize"
      },
      "expected_error": "contract.unsupported_enum"
    },
    {
      "id": "revocation-sync-unavailable-allows-artifact-read",
      "builder": "evaluate_rule_with_added_allowed_operation",
      "scenario": {
        "rule_id": "revocation-sync-unavailable",
        "added_operation": "artifact_read"
      },
      "expected_error": "runtime.admission_requirements_unsatisfied"
    },
    {
      "id": "redactor-unavailable-allows-public-artifact-path",
      "builder": "evaluate_redaction_requirement_with_unavailable_redactor",
