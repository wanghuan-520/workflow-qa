    {
      "id": "table-migration-schema-after-mismatch",
      "case_kind": "stateful_behavior",
      "builder": "resume_migration_from_durable_markers",
      "scenario": {
        "journal_schema_before": 4,
        "expected_schema_after": 5,
        "observed_schema_after": 6
      },
      "expected_error": "update.migration_incomplete",
      "expected_state": {
        "mode": "recovery_only",
        "admission": "closed"
      }
    },
    {
      "id": "recovery-only-release-signing-key-mismatch",
      "case_kind": "stateful_behavior",
      "builder": "start_recovery_only_candidate_with_manifest_key_mismatch",
      "scenario": {
        "manifest_key_id": "release-key-2",
        "trusted_key_id": "release-key-1",
