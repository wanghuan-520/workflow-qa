        "candidate_reader_schema_range": {
          "min": 3,
          "max": 4
        },
        "candidate_writer_schema_range": {
          "min": 3,
          "max": 4
        },
        "previous_reader_schema_range": {
          "min": 3,
          "max": 4
        },
        "previous_writer_schema_range": {
          "min": 3,
          "max": 4
        }
      },
      "expected": {
        "migration_markers_gapless": true,
        "health_evidence_durable_before_selection": true,
        "automatic_rollback_allowed": true
      }
    },
    {
      "id": "table-backfill-checkpoint-before-selection",
      "case_kind": "stateful_behavior",
      "builder": "activate_migration_with_chunked_table_backfill",
      "scenario": {
        "table": "audit_events",
        "source_schema": 4,
        "target_schema": 5,
        "chunks": 4,
        "checkpoint_after_each_chunk": true,
        "selection_commit_after_health_evidence": true
      },
      "expected": {
        "migration_state": "committed",
        "checkpoint_compatibility_verified": true,
        "selection_committed": true
      }
    }
