    {
      "id": "expand-contract-additive-table-migration",
      "case_kind": "stateful_behavior",
      "builder": "activate_expand_contract_schema_migration",
      "scenario": {
        "source_sqlite_schema_range": {
          "min": 3,
          "max": 3
        },
        "target_sqlite_schema_version": 4,
        "migration_strategy": "expand_contract",
        "table_changes": [
          {
            "table": "effect_records_v2",
            "operation": "create",
            "compatibility": "additive"
