    {
      "id": "recovery-only-ledger-checkpoint-root-mismatch",
      "case_kind": "stateful_behavior",
      "builder": "start_recovery_only_candidate_with_checkpoint_mismatch",
      "scenario": {
        "checkpoint_compatibility_versions": [
          4,
          5
        ],
        "observed_schema": 5,
        "signed_event_outbox_root": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "recomputed_event_outbox_root": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
      },
      "expected_error": "ledger.integrity_root_mismatch",
      "expected_state": {
        "mode": "recovery_only",
        "admission": "closed",
        "runtime_status": "unhealthy"
      }
