{
  "schema_version": "qa.rfc8785-conformance/v1",
  "description": "Shared Rust and TypeScript RFC 8785/JCS conformance corpus for FKST QA contracts.",
  "encoding": "UTF-8",
  "digest_algorithm": "sha256",
  "rules": {
    "canonicalization": "RFC 8785 JSON Canonicalization Scheme",
    "input_profile": "I-JSON with FKST safe-integer constraints",
    "unicode_normalization": "forbidden",
    "object_member_order": "UTF-16 code unit order",
    "encoded_source": "base64 of the exact input bytes before parsing"
  },
  "projection_registry": [
    "contract_content/v1",
    "signed_root/v1",
    "local_request/v1",
    "mvp_local_request/v1",
    "mvp_local_read/v1",
    "mvp_local_cancel/v1",
    "authorization_preimage/v1",
    "admission_requirements/v1",
    "execution_fence/v1",
    "event_set/v1",
    "channel_transcript/v1",
    "update_activation/v1",
    "revocation_batch/v1",
    "audit_event_set/v1",
    "ledger_integrity/v1"
  ],
  "related_corpora": [
    "contract-projection-signing-v1.json",
    "runtime-protocol-corpus-v1.json",
    "boot-bound-vsock-v1.json",
    "runtime-update-compatibility-v1.json",
    "runtime-degraded-operation-matrix-v1.json",
    "orchestration-quality-publication-pql-v1.json",
    "runtime-sandbox-security-v1.json"
  ],
