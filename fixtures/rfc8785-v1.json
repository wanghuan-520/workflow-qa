  "invalid_cases": [
    {
      "id": "duplicate-member-name",
      "source_form": "encoded_source",
      "encoded_source_base64": "eyJhIjoxLCJhIjoyfQ==",
      "expected_error": "canonicalization.duplicate_member"
    },
    {
      "id": "lone-high-surrogate",
      "source_form": "encoded_source",
      "encoded_source_base64": "eyJ2YWx1ZSI6Ilx1ZDgwMCJ9",
      "expected_error": "canonicalization.invalid_unicode_scalar"
    },
    {
      "id": "invalid-utf8",
      "source_form": "encoded_source",
      "encoded_source_base64": "eyJ4IjoiwygifQ==",
      "expected_error": "canonicalization.invalid_utf8"
    },
    {
      "id": "nan-token",
      "source_form": "encoded_source",
      "encoded_source_base64": "eyJ2YWx1ZSI6TmFOfQ==",
      "expected_error": "canonicalization.invalid_json_number"
    },
    {
      "id": "positive-infinity-token",
      "source_form": "encoded_source",
      "encoded_source_base64": "eyJ2YWx1ZSI6SW5maW5pdHl9",
      "expected_error": "canonicalization.invalid_json_number"
    },
    {
      "id": "unsafe-integer-token",
      "source_form": "encoded_source",
      "encoded_source_base64": "eyJ2YWx1ZSI6OTAwNzE5OTI1NDc0MDk5Mn0=",
      "expected_error": "canonicalization.unsafe_integer"
    }
  ],
  "projection_purposes": {
    "contract_content/v1": "Exact root object with root content_digest removed and root signature removed when present.",
    "signed_root/v1": "Validated root containing content_digest with root signature removed before constructing the canonical signing payload.",
    "local_request/v1": "Exact local request with root authentication and request_digest removed while preserving nested digests and signatures.",
    "mvp_local_request/v1": "Exact LocalQARunRequest body with root content_digest, authorization, and request_digest removed while preserving every other field and nested digest.",
    "mvp_local_read/v1": "Exact LocalQAReadRequest with root transport and authorization removed while preserving the complete snapshot/events target, cursor, and limit.",
    "mvp_local_cancel/v1": "Exact LocalQACancelRequest with root content_digest, transport, authorization, and request_digest removed while preserving every other field.",
    "authorization_preimage/v1": "Complete strict Design or Execution admission preimage with no nested field removal.",
    "admission_requirements/v1": "Entire exact AdmissionRequirements object.",
    "execution_fence/v1": "Entire exact ExecutionFence object.",
    "event_set/v1": "Cursor-ordered array of cursor and event_content_digest pairs; array order is material.",
    "channel_transcript/v1": "Strict boot and channel transcript binding boot evidence, both ephemeral keys, nonce, descriptor, fence, boot epoch, and algorithms.",
    "update_activation/v1": "Strict activation preimage binding staged receipt, manifest, selection predecessor, schema state, deadline, and activation nonce.",
    "revocation_batch/v1": "Exact batch header and ordered strict revocation facts with sequence, predecessor digest, watermark, TTL, and nonce.",
    "audit_event_set/v1": "Audit-sequence-ordered audit_sequence and audit_event_digest pairs with range and linkage material.",
    "ledger_integrity/v1": "SQLite schema and transaction watermark, WAL checkpoint, ledger, audit, outbox, inventory, effect roots, and previous checkpoint."
  }
}
