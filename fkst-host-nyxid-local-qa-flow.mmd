flowchart TB
  subgraph HOSTED["FKST Hosted Control Plane"]
    direction LR
    ORCH["Durable QA Orchestrator<br/>Source / Plan / Policy / Profile"]
    STORE["Artifact Ingestion + Object Store<br/>ArtifactPointer / retention"]
    REPORT["Quality + Report Composer<br/>JSON / HTML / Markdown"]
    PUB["GitHub / PQL Publication<br/>independent receipts"]
    ORCH --> STORE --> REPORT --> PUB
  end

  subgraph NYXID["NyxID Transport and Credential Boundary"]
    direction LR
    CLOUD["NyxID Cloud<br/>identity / scope / approval / audit"]
    SERVICE["Explicit Node-pinned Service<br/>stable route, fail closed"]
    NODE["NyxID Node<br/>outbound channel + local credential injection"]
    CLOUD --> SERVICE --> NODE
  end

  subgraph AGENT["Local QA Agent MVP"]
    direction TB
    API["Five authenticated endpoints<br/>health / put run / get / events / cancel"]
    COORD["Run Coordinator + Small SQLite Journal<br/>idempotency / state / event / ownership"]
    ENV["Source + Container Environment<br/>App / DB / Middleware / Readiness"]
    EXEC["testing-runner<br/>Assertions decide CaseResult"]
    BROWSER["Host Chrome Controller<br/>dedicated process + temporary profile"]
    EVIDENCE["Evidence Stager<br/>quarantine / redaction / digest"]
    CLEAN["Cleanup Manager<br/>release execution resources first"]
    UPLOAD["Upload Client<br/>post-redaction grant exchange"]
    API <--> COORD
    COORD --> ENV --> EXEC
    COORD --> BROWSER
    EXEC --> EVIDENCE
    BROWSER --> EVIDENCE
    EVIDENCE --> CLEAN
    EVIDENCE --> UPLOAD
    CLEAN --> COORD
    UPLOAD --> COORD
  end

  CONTAINERS["Per-run Containers<br/>application / database / middleware"]
  CHROME["System Google Chrome<br/>isolated profile and downloads"]

  ORCH -->|"signed LocalQARequestAuthorization"| CLOUD
  NODE -->|"authenticated loopback request"| API
  API -->|"snapshot / bounded event batch"| NODE
  CLOUD -->|"routed response"| ORCH

  ENV --> CONTAINERS
  BROWSER --> CHROME
  UPLOAD -->|"short-lived per-object capability<br/>sanitized bytes only"| STORE

  FUTURE["Future Hardened Profile<br/>VZ / Grant / Fence / EffectGate / authority ledger"]
  ORCH -.->|"only when hostile-code or high-value-secret policy requires"| FUTURE

  NOTE["Boundary<br/>NyxID does not start containers or Chrome,<br/>execute tests, decide Pass/Fail, or compose reports"]
  NOTE -.-> NYXID

  classDef hosted fill:#E8F0FE,stroke:#3367D6,color:#102A43,stroke-width:2px;
  classDef nyxid fill:#E6F4F1,stroke:#17857E,color:#123C39,stroke-width:2px;
  classDef agent fill:#EAF5E7,stroke:#4C9445,color:#173C16,stroke-width:2px;
  classDef resource fill:#FFF4E2,stroke:#D58A20,color:#4A2A00,stroke-width:2px;
  classDef future fill:#F3ECF8,stroke:#7852A4,color:#332044,stroke-width:2px;
  classDef boundary fill:#FCE8E6,stroke:#C5221F,color:#5F1613,stroke-width:2px;

  class ORCH,STORE,REPORT,PUB hosted;
  class CLOUD,SERVICE,NODE nyxid;
  class API,COORD,ENV,EXEC,BROWSER,EVIDENCE,CLEAN,UPLOAD agent;
  class CONTAINERS,CHROME resource;
  class FUTURE future;
  class NOTE boundary;
