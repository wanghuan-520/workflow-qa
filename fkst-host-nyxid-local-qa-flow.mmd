flowchart TB
  subgraph HOSTED["FKST Hosted Control Plane"]
    direction LR
    H["RunDraft + SourceAcquisition<br/>freeze RunSpec / effective SHA"]
    PA["Policy + Approval Evidence<br/>Design scope / Execution Plan"]
    AA["Hosted Authorization Authority<br/>only Grant / RecoveryDecision issuer"]
    AMEND["Immutable PlanAmendment<br/>old revocation + Cleanup receipts<br/>new Plan / approvals / Grants / ResumeDirective"]
    QE["quality-evaluation<br/>immutable Final Quality Outcome"]
    PUB["PublicationPlan<br/>independent per-action settlement"]
    GH["GitHub Actions<br/>Check / Comment / Product Issue<br/>dedup + reconcile + Receipt"]
    GAP["PQL CoverageGap<br/>stable dedup key"]
    PROP["AssetChangeProposal<br/>design_only"]
    REVIEW["PQLReviewDecision<br/>immutable approval / rejection"]
    PROMOTE["ProjectPackPromotionReceipt<br/>stale-base conflict safe"]
    H --> PA --> AA
    QE --> PUB --> GH
    QE -->|"eligible classification"| GAP --> PROP --> REVIEW --> PROMOTE
    PROMOTE -. "new Project Pack<br/>next Run only" .-> H
  end

  subgraph CHANNEL["NyxID Device Channel"]
    direction LR
    N["NyxID Transport<br/>outbound device route<br/>objects unchanged"]
  end

  subgraph LOCAL["apps/local-qa-runtime / macOS user session"]
    direction TB
    API["Authenticated RuntimeService — exactly 8<br/>probeHealth / reserveLocalLeaseBinding / cancelReservation / submitCommand<br/>getRun / streamEvents / ackEvents / getArtifact"]
    INBOX["RuntimeTransportControlInbox<br/>deliverRevocations only — not RuntimeService<br/>durable ack + watermark; stale / gap fails closed"]
    RV["Local Runtime Verifier<br/>idempotency first<br/>snapshot / binding / signature / nonce"]
    ADM["AdmissionFacade + LedgerWriter<br/>lease / fence / strict predecessor<br/>inventory root / capability / outbox"]
    AUD["Append-only signed AuditEvent<br/>AuditCheckpoint + LedgerIntegrityCheckpoint<br/>passed verification before admission"]
    PEP{"EffectAuthority / Local PEP<br/>phase-specific context<br/>all host effects mediated"}
    UGATE{"M2 first untrusted-flow Gate<br/>dependency integrity / hard ceilings / per-flow egress<br/>quarantine + redaction / audit checkpoint / crash containment"}
    ADP["Trusted Adapters<br/>VZ / Warden / gateway / port<br/>Secret helper / Browser / Artifact"]
    SET["Generation Settlement<br/>quiesce + reconcile<br/>seal then cleanup"]
    RET["Signed EventBatch / Receipt<br/>Audit / Ledger Checkpoints<br/>sanitized ArtifactPointer"]

    API --> RV --> ADM
    INBOX -->|"atomic watermark + audit outbox"| ADM
    ADM -->|"append + checkpoint"| AUD
    ADM -->|"commit before effects"| PEP --> ADP
    PEP -->|"arm enforcement before untrusted flow"| UGATE
    AUD --> RET
    ADP --> SET --> RET --> API
  end

  subgraph DESIGN["Fresh Design VM / generation"]
    direction LR
    DG["Guest Agent<br/>boot-bound authenticated vsock"]
    DW["testing-design<br/>static source read only"]
    PLAN["Structured Plan vN<br/>PlanDiff when amendment"]
    DG --> DW --> PLAN
  end

  subgraph EXECUTION["Fresh Execution VM / generation"]
    direction LR
    EG["Guest Agent<br/>new boot / disk / session"]
    ENV["Workspace + App + Middleware<br/>process domains / mediated network"]
    RUN["testing-runner + Backends<br/>assertions decide CaseResult"]
    EG --> ENV --> RUN
  end

  subgraph CONTROL["Cancellation, Amendment and Recovery"]
    direction LR
    AMREQ["PlanAmendmentRequest<br/>no new authority"]
    REVOKE["Hard revoke old Execution Grant<br/>fence old generation"]
    LAT["Local recovery latch<br/>session invalidation + read-only discovery"]
    SNAP["Runtime / Ledger / Admission Snapshot"]
    DEC["Signed RecoveryDecision<br/>wait / resume / reconcile_and_seal<br/>advance / irreconcilable"]
    QR["control_quiesce_reconcile<br/>suppress / quiesce / terminate / revoke"]
    SEAL["New sealed inventory<br/>InventorySealReceipt"]
    DEC2["Signed replay_cleanup Decision<br/>seal + successor capability bound"]
    CL["control_cleanup<br/>release / delete / revoke"]
    AMREQ --> REVOKE --> QR --> SEAL --> CL
    LAT --> SNAP --> DEC
    DEC -->|"reconcile_and_seal"| QR
    DEC2 --> CL
  end

  H -->|"reservation request"| N --> API
  API -->|"signed LocalLeaseBinding"| N --> AA
  AA -->|"Design Grant"| N --> API
  UGATE -->|"Design bootstrap"| DG
  PLAN --> SET
  RET -->|"Plan + Design CleanupReceipt"| N --> PA
  AA -->|"Execution Grant"| N --> API
  UGATE -->|"Execution bootstrap / Step"| EG
  RUN -->|"raw evidence"| ADP
  RET --> N --> QE

  REVOKE -->|"signed RevocationBatch"| N --> INBOX
  INBOX -->|"durable RevocationDeliveryReceipt<br/>ack is not Cancel / Cleanup"| N

  PEP -->|"out of envelope<br/>amendment_required before effect"| AMREQ
  CL -->|"amendment CleanupReceipt"| RET
  PLAN -->|"new Plan vN + Diff"| AMEND
  AA -->|"new Design / Execution Grants"| AMEND
  RET -->|"revocation + old / Design Cleanup receipts"| N --> AMEND
  AMEND -->|"AmendmentResumeCommand<br/>new execution generation"| N --> API

  ADM -->|"cancel / timeout intent"| QR
  SET -->|"crash / lost owner"| LAT
  SNAP -->|"via NyxID"| N --> AA
  AA -->|"resume: reserve + binding + Grant, then signed decision"| N --> DEC
  SEAL -->|"seal receipt via NyxID"| N --> AA
  AA -->|"signed replay_cleanup decision"| N --> DEC2
  CL --> RET

  classDef hosted fill:#E8F0FE,stroke:#3367D6,color:#102A43,stroke-width:2px;
  classDef nyxid fill:#E6F4F1,stroke:#17857E,color:#123C39,stroke-width:2px;
  classDef local fill:#EAF5E7,stroke:#4C9445,color:#173C16,stroke-width:2px;
  classDef worker fill:#FFF4E2,stroke:#D58A20,color:#4A2A00,stroke-width:2px;
  classDef pql fill:#F3E8FD,stroke:#7E57C2,color:#32145F,stroke-width:2px;
  classDef gate fill:#FCE8E6,stroke:#C5221F,color:#5F1613,stroke-width:2px;
  classDef neutral fill:#F5F7F8,stroke:#607D8B,color:#263238,stroke-width:2px;

  class H,PA,AA,AMEND,QE,PUB,GH hosted;
  class GAP,PROP,REVIEW,PROMOTE pql;
  class N nyxid;
  class API,INBOX,RV,ADM,AUD,ADP,SET,RET local;
  class DG,DW,PLAN,EG,ENV,RUN worker;
  class PEP,UGATE,REVOKE,QR,CL gate;
  class AMREQ,LAT,SNAP,SEAL,DEC,DEC2 neutral;
