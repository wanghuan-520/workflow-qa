graph TD
  subgraph GH["GitHub / Owner Repo"]
    A["PR 合并或手工创建<br/>fkst-qa Issue"]
    N["创建去重的 fkst-dev Issue"]
    O["回写 QA Issue<br/>环境 / 凭据 / Harness / Flaky"]
    P["发布运行总结并关闭<br/>fkst-qa Issue"]
  end

  subgraph HOSTED["fkst-hosted：Session 与 Sandbox 生命周期"]
    B["识别 fkst-qa 待处理工作"]
    C["创建独立 QA Session<br/>2 CPU / 4Gi Sandbox"]
    D["附加 QA Profile<br/>注入 Env / Secret"]
    E{"Bootstrap 模式"}
    F2["Phase 2<br/>Agent 前执行 install-plan.json"]
    Q["无开放 QA 工作<br/>Session idle-to-zero"]
    R["销毁 QA Sandbox"]
  end

  subgraph TESTING["fkst-packages-testing：workflow-qa 编排与测试执行"]
    G["workflow-qa<br/>建立 run_key 与 GitHub Ledger"]
    H["discover-stack<br/>生成 Stack Manifest"]
    I["propose-test-cases<br/>生成 Test Plan"]
    F1["Phase 1 Bootstrap<br/>Codex 下载并启动 Middleware"]
    J["bootstrap-and-run<br/>启动 Owner Service 并执行全部用例"]
    K["规范化结果与分类<br/>生成 Execution Receipt"]
    L["Artifact + Publication<br/>证据指针 / trace_id / dedup_key"]
    M{"结果分类"}
  end

  A --> B
  B --> C
  C --> D
  D --> E
  E -- "Phase 1" --> G
  E -- "Phase 2" --> F2
  F2 --> G
  G --> H
  H --> I
  I -- "Phase 1" --> F1
  F1 --> J
  I -- "Phase 2：Middleware 已就绪" --> J
  J --> K
  K --> L
  L --> M
  M -- "product-defect" --> N
  M -- "environment / credential / harness / flaky" --> O
  M -- "passed" --> P
  N --> P
  O --> P
  P --> Q
  Q --> R

  classDef github fill:#E8F0FE,stroke:#3367D6,color:#102A43;
  classDef hosted fill:#E6F4EA,stroke:#188038,color:#123524;
  classDef testing fill:#FFF4E5,stroke:#B06000,color:#4A2A00;
  classDef decision fill:#FCE8E6,stroke:#C5221F,color:#5F1613;

  class A,N,O,P github;
  class B,C,D,F2,Q,R hosted;
  class G,H,I,F1,J,K,L testing;
  class E,M decision;
