flowchart TB
  subgraph TOP["设计与授权"]
    direction LR
    A["fkst-hosted + NyxID Cloud<br/>创建 Durable QA Run<br/>锁定 repo / effective ref / profile<br/>用户批准 Design-only Grant"]
    B["Local QA Runtime · Local Design<br/>读取本地 Workspace / exact ref<br/>复用本地源码、依赖信息与 PQL 资产<br/>生成 Structured Plan v1，此阶段不执行测试"]
    C{"Policy Gate + 用户审批<br/>审查命令 · 文件 · 网络 · Secret · 资源预算<br/>确认 plan_digest"}
    D["NyxID Execution Grant<br/>绑定 plan_digest · commit · device · policy_digest<br/>scope · 资源上限 · TTL · nonce"]
    E["Local QA Sandbox<br/>运行在用户电脑的 Container / VM<br/>挂载本次 Run Workspace并安装依赖<br/>启动 Middleware / App / Browser Profile，按 Plan 执行 Readiness"]
    A --> B --> C -->|"批准"| D --> E
  end

  subgraph BOTTOM["执行、补偿、质量裁决与反馈闭环"]
    direction LR
    F["testing-runner<br/>选择 Deterministic / Browser / Codex Backend<br/>最终 Pass / Fail 由结构化断言决定"]
    G{"动作是否超出<br/>已批准 action envelope?"}
    H["Case Result + EvidenceManifest<br/>日志 · 截图 · Trace · 结构化断言<br/>脱敏 · digest · access scope · retention"]
    I["任意终态 / Runtime 重启恢复<br/>始终触发 Compensation Cleanup<br/>Cleanup 幂等、可单独重试并输出 Receipt<br/>execution / cleanup / evidence Outcome 独立记录"]
    J["NyxID 回传 → quality-evaluation<br/>聚合 Case Result · Coverage · Evidence Gate<br/>失败分类 · Final Quality Outcome · dedup key"]
    K["test-publication + GitHub Adapter<br/>只消费 QualityEvaluation<br/>幂等发布 Check / Comment / Run Summary<br/>产品缺陷 Issue 需可复现且 Evidence 充分"]
    L["workflow-qa Finalize<br/>校验 Checkpoint / Receipt<br/>可恢复、可重放、不重复启动或发布"]
    F --> G -->|"在批准范围内"| H --> I --> J --> K --> L
  end

  E --> F

  C -->|"拒绝"| X["Blocked<br/>记录原因与审计"]
  G -->|"新增 Step / 权限 / Secret / 网络 / 预算"| AMEND["Plan Amendment 返回点<br/>生成 Plan vN + 结构化 Diff<br/>暂停 Run · 保存 Checkpoint · 撤销旧 Grant<br/>重新进入 Policy Gate 与用户审批"]

  J -->|"测试资产 / 覆盖 / Flaky / Evidence 问题"| PQL["PQL Learning Loop<br/>Coverage Gap / Asset Proposal → Review Gate<br/>新用例先 design_only<br/>批准后的新 Project Pack 进入下一轮 Run"]

  CONTRACT["统一数据契约<br/>Plan / Grant / Receipt / Evidence / Quality 均包含<br/>schema_version · content_digest · run_id<br/>created_at · producer_version"]
  CONTRACT -.-> J

  classDef hosted fill:#E8F0FE,stroke:#3367D6,color:#102A43,stroke-width:2px;
  classDef nyxid fill:#E6F4F1,stroke:#17857E,color:#123C39,stroke-width:2px;
  classDef local fill:#EAF5E7,stroke:#4C9445,color:#173C16,stroke-width:2px;
  classDef testing fill:#F3ECF8,stroke:#7852A4,color:#332044,stroke-width:2px;
  classDef pql fill:#FFF4E2,stroke:#D58A20,color:#4A2A00,stroke-width:2px;
  classDef gate fill:#FCE8E6,stroke:#C5221F,color:#5F1613,stroke-width:2px;
  classDef neutral fill:#F5F7F8,stroke:#607D8B,color:#263238,stroke-width:2px;

  class A hosted;
  class D nyxid;
  class B,E,I local;
  class F,H,J,K,L,AMEND testing;
  class PQL pql;
  class C,G,X gate;
  class CONTRACT neutral;
